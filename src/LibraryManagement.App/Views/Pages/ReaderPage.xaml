<Page
    x:Class="LibraryManagement.App.Views.Pages.ReaderPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Quản lý độc giả"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="28"
            FontWeight="SemiBold"
            Text="Quản lý độc giả" />

        <TabControl
            Grid.Row="1"
            Margin="0,18,0,0"
            SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Danh sách độc giả">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            MaxLength="150"
                            PlaceholderText="Mã, tên, điện thoại hoặc email..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding StatusFilters}"
                            SelectedItem="{Binding SelectedStatusFilter}" />
                        <ComboBox
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            DisplayMemberPath="DisplayName"
                            ItemsSource="{Binding TypeFilters}"
                            SelectedItem="{Binding SelectedTypeFilter}" />
                        <ui:Button
                            Grid.Column="3"
                            Margin="10,0,0,0"
                            Command="{Binding SearchCommand}"
                            Content="Tìm kiếm" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <DataGrid
                            x:Name="ReaderGrid"
                            AutomationProperties.Name="Danh sách độc giả"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Readers}"
                            SelectedItem="{Binding SelectedReader}"
                            Sorting="OnReaderGridSorting">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding ReaderCode}"
                                    Header="Mã độc giả"
                                    SortMemberPath="ReaderCode" />
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding FullName}"
                                    Header="Họ và tên"
                                    SortMemberPath="FullName" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding ReaderType, Converter={StaticResource ReaderTypeConverter}}"
                                    Header="Loại độc giả"
                                    SortMemberPath="ReaderType" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding PhoneNumber}"
                                    CanUserSort="False"
                                    Header="Điện thoại" />
                                <DataGridTextColumn
                                    Width="130"
                                    Binding="{Binding ExpirationDate}"
                                    Header="Ngày hết hạn"
                                    SortMemberPath="ExpirationDate" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Status, Converter={StaticResource ReaderStatusConverter}}"
                                    Header="Trạng thái"
                                    SortMemberPath="Status" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Không có độc giả phù hợp.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasItems, ElementName=ReaderGrid}"
                                            Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel HorizontalAlignment="Left">
                            <ui:Button
                                Appearance="Primary"
                                Command="{Binding NewCommand}"
                                Content="Thêm độc giả" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding EditCommand}"
                                Content="Sửa" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding LockCommand}"
                                Content="Khóa" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding UnlockCommand}"
                                Content="Mở khóa" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding RenewCardCommand}"
                                Content="Gia hạn thẻ" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding ViewHistoryCommand}"
                                Content="Lịch sử mượn" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Command="{Binding ViewFinesCommand}"
                                Content="Tiền phạt" />
                        </WrapPanel>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Center"
                            Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding PreviousPageCommand}"
                                Content="Trước" />
                            <TextBlock
                                Margin="12,0"
                                VerticalAlignment="Center"
                                Text="{Binding PageSummary}" />
                            <ui:Button
                                Command="{Binding NextPageCommand}"
                                Content="Sau" />
                        </StackPanel>
                        <StackPanel
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <TextBlock
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Text="{Binding TotalCount, StringFormat=Tổng: {0}}" />
                            <ComboBox
                                Width="70"
                                ItemsSource="{Binding PageSizes}"
                                SelectedItem="{Binding PageSize}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Thêm / cập nhật">
                <ScrollViewer
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Auto">
                    <Grid
                        MinWidth="680"
                        MaxWidth="900"
                        Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Mã độc giả *" />
                            <ui:TextBox
                                x:Name="ReaderCodeInput"
                                Margin="0,6,0,0"
                                IsEnabled="{Binding CanEditIdentity}"
                                MaxLength="20"
                                Text="{Binding ReaderCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ReaderCodeInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=ReaderCodeInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Họ và tên *" />
                            <ui:TextBox
                                x:Name="FullNameInput"
                                Margin="0,6,0,0"
                                MaxLength="150"
                                Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=FullNameInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=FullNameInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Ngày sinh" />
                            <DatePicker
                                x:Name="DateOfBirthInput"
                                Margin="0,6,0,0"
                                SelectedDate="{Binding DateOfBirth, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=DateOfBirthInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=DateOfBirthInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Giới tính *" />
                            <ComboBox
                                Margin="0,6,0,0"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding Genders}"
                                SelectedItem="{Binding SelectedGender, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Loại độc giả *" />
                            <ComboBox
                                Margin="0,6,0,0"
                                DisplayMemberPath="DisplayName"
                                ItemsSource="{Binding ReaderTypes}"
                                SelectedItem="{Binding SelectedReaderType, ValidatesOnNotifyDataErrors=True}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Điện thoại" />
                            <ui:TextBox
                                x:Name="PhoneInput"
                                Margin="0,6,0,0"
                                MaxLength="20"
                                Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=PhoneInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=PhoneInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="Email" />
                            <ui:TextBox
                                x:Name="EmailInput"
                                Margin="0,6,0,0"
                                MaxLength="254"
                                Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=EmailInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=EmailInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Địa chỉ" />
                            <ui:TextBox
                                MinHeight="64"
                                Margin="0,6,0,0"
                                AcceptsReturn="True"
                                MaxLength="500"
                                Text="{Binding Address}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Ngày đăng ký *" />
                            <DatePicker
                                x:Name="RegisteredAtInput"
                                Margin="0,6,0,0"
                                IsEnabled="{Binding CanEditCardDates}"
                                SelectedDate="{Binding RegisteredAt, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=RegisteredAtInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=RegisteredAtInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Ngày hết hạn *" />
                            <DatePicker
                                x:Name="ExpirationDateInput"
                                Margin="0,6,0,0"
                                IsEnabled="{Binding CanEditCardDates}"
                                SelectedDate="{Binding ExpirationDate, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=ExpirationDateInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=ExpirationDateInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Đường dẫn ảnh đại diện" />
                            <ui:TextBox
                                Margin="0,6,0,0"
                                MaxLength="500"
                                Text="{Binding AvatarPath}" />

                            <TextBlock
                                Margin="0,12,0,0"
                                FontWeight="SemiBold"
                                Text="Ghi chú" />
                            <ui:TextBox
                                MinHeight="80"
                                Margin="0,6,0,0"
                                AcceptsReturn="True"
                                MaxLength="1000"
                                Text="{Binding Notes}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button
                                MinHeight="42"
                                Margin="0,16,0,0"
                                Appearance="Primary"
                                Command="{Binding SaveCommand}"
                                Content="Lưu độc giả" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Lịch sử mượn">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="0,0,0,10"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="{Binding SelectedReaderName, StringFormat=Lịch sử mượn của {0}}" />
                    <Grid Grid.Row="1">
                        <DataGrid
                            x:Name="HistoryGrid"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding BorrowHistory}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="130" Binding="{Binding BorrowCode}" Header="Mã phiếu" />
                                <DataGridTextColumn Width="110" Binding="{Binding CopyCode}" Header="Mã bản" />
                                <DataGridTextColumn Width="2*" Binding="{Binding BookTitle}" Header="Tên sách" />
                                <DataGridTextColumn Width="110" Binding="{Binding BorrowDate}" Header="Ngày mượn" />
                                <DataGridTextColumn Width="110" Binding="{Binding ExpectedReturnDate}" Header="Hẹn trả" />
                                <DataGridTextColumn Width="110" Binding="{Binding ActualReturnDate}" Header="Ngày trả" />
                                <DataGridTextColumn Width="80" Binding="{Binding RenewalCount}" Header="Gia hạn" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Status, Converter={StaticResource BorrowSlipDetailStatusConverter}}"
                                    Header="Trạng thái" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Độc giả chưa có lịch sử mượn.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasItems, ElementName=HistoryGrid}"
                                            Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Tiền phạt">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10" Orientation="Horizontal">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedReaderName, StringFormat=Tiền phạt của {0}}" />
                        <TextBlock
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding OutstandingFineTotal, StringFormat=Còn phải thu: {0:N0} đ}" />
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <DataGrid
                            x:Name="FineGrid"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding OutstandingFines}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="130" Binding="{Binding FineCode}" Header="Mã tiền phạt" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding FineType, Converter={StaticResource FineTypeConverter}}"
                                    Header="Loại phạt" />
                                <DataGridTextColumn Width="110" Binding="{Binding Amount, StringFormat={}{0:N0}}" Header="Số tiền" />
                                <DataGridTextColumn Width="110" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Header="Đã thu" />
                                <DataGridTextColumn Width="110" Binding="{Binding OutstandingAmount, StringFormat={}{0:N0}}" Header="Còn lại" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding Status, Converter={StaticResource FineStatusConverter}}"
                                    Header="Trạng thái" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Reason}" Header="Lý do" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Độc giả không có tiền phạt chưa thanh toán.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger
                                            Binding="{Binding HasItems, ElementName=FineGrid}"
                                            Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="50"
            Background="#66000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="White"
                    Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
