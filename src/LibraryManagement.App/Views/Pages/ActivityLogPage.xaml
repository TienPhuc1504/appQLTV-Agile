<Page
    x:Class="LibraryManagement.App.Views.Pages.ActivityLogPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Nhật ký hoạt động"
    Loaded="OnLoaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="28" FontWeight="SemiBold" Text="Nhật ký hoạt động" />
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="140" />
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="145" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Margin="0,0,8,0"
                PlaceholderText="Mô tả, đối tượng hoặc mã..."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ui:TextBox
                Grid.Column="1"
                Margin="0,0,8,0"
                PlaceholderText="Hành động"
                Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged}" />
            <ui:TextBox
                Grid.Column="2"
                Margin="0,0,8,0"
                PlaceholderText="ID nhân viên"
                Text="{Binding EmployeeIdFilter, UpdateSourceTrigger=PropertyChanged}" />
            <DatePicker Grid.Column="3" Margin="0,0,8,0" SelectedDate="{Binding FromDate}" />
            <DatePicker Grid.Column="4" Margin="0,0,8,0" SelectedDate="{Binding ToDate}" />
            <ui:Button Grid.Column="5" Command="{Binding SearchCommand}" Content="Tìm kiếm" />
        </Grid>
        <DataGrid
            Grid.Row="2"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            IsReadOnly="True"
            ItemsSource="{Binding ActivityLogs}">
            <DataGrid.Columns>
                <DataGridTextColumn Width="135" Binding="{Binding CreatedAt, StringFormat=dd/MM/yyyy HH:mm}" Header="Thời gian" />
                <DataGridTextColumn Width="100" Binding="{Binding EmployeeCode}" Header="Mã NV" />
                <DataGridTextColumn Width="150" Binding="{Binding EmployeeName}" Header="Nhân viên" />
                <DataGridTextColumn Width="140" Binding="{Binding Action}" Header="Hành động" />
                <DataGridTextColumn Width="120" Binding="{Binding EntityName}" Header="Đối tượng" />
                <DataGridTextColumn Width="90" Binding="{Binding EntityId}" Header="Mã" />
                <DataGridTextColumn Width="*" Binding="{Binding Description}" Header="Mô tả" />
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                <ui:Button Command="{Binding PreviousPageCommand}" Content="Trước" />
                <TextBlock Margin="14,0" VerticalAlignment="Center" Text="{Binding PageNumber, StringFormat=Trang {0}}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding TotalPages, StringFormat=/ {0}}" />
                <ui:Button Margin="14,0,0,0" Command="{Binding NextPageCommand}" Content="Sau" />
                <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="{Binding TotalCount, StringFormat=Tổng: {0}}" />
            </StackPanel>
        </Grid>
        <Border
            Grid.RowSpan="4"
            Panel.ZIndex="10"
            Background="#66000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock Margin="0,10,0,0" Foreground="White" Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
