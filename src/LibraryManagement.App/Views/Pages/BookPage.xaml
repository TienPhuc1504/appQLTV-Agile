<Page
    x:Class="LibraryManagement.App.Views.Pages.BookPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:LibraryManagement.App.Controls"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Quản lý sách"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{StaticResource SectionSpacing}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Description="Tra cứu và quản lý thông tin các đầu sách trong thư viện."
            Title="Quản lý sách">
            <controls:PageHeader.TrailingContent>
                <ui:Button
                    Appearance="Primary"
                    Command="{Binding NewCommand}"
                    Content="Thêm sách" />
            </controls:PageHeader.TrailingContent>
        </controls:PageHeader>

        <TabControl
            Grid.Row="2"
            SelectedIndex="{Binding SelectedTabIndex}">
            <TabItem Header="Danh sách sách">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox
                            PlaceholderText="Mã sách, ISBN, tên sách hoặc tác giả..."
                            Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Categories}"
                            SelectedItem="{Binding CategoryFilter}" />
                        <ComboBox
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            DisplayMemberPath="Name"
                            ItemsSource="{Binding Publishers}"
                            SelectedItem="{Binding PublisherFilter}" />
                        <CheckBox
                            Grid.Column="3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Content="Hiện ngừng lưu hành"
                            IsChecked="{Binding IncludeInactive}" />
                        <ui:Button
                            Grid.Column="4"
                            Margin="8,0,0,0"
                            Command="{Binding SearchCommand}"
                            Content="Tìm kiếm"
                            Icon="{ui:SymbolIcon Search24}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,12,0,0">
                        <DataGrid
                            x:Name="BookGrid"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding Books}"
                            SelectedItem="{Binding SelectedBook}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="90" Binding="{Binding BookCode}" Header="Mã sách" />
                                <DataGridTextColumn Width="2*" Binding="{Binding Title}" Header="Tên sách" />
                                <DataGridTextColumn Width="*" Binding="{Binding Authors}" Header="Tác giả" />
                                <DataGridTextColumn Width="*" Binding="{Binding PublisherName}" Header="Nhà xuất bản" />
                                <DataGridTextColumn Width="75" Binding="{Binding AvailableCopies}" Header="Có sẵn" />
                                <DataGridCheckBoxColumn Width="80" Binding="{Binding IsActive}" Header="Lưu hành" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Không có sách phù hợp.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasItems, ElementName=BookGrid}" Value="False">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button Command="{Binding EditCommand}" Content="Sửa" />
                            <ui:Button
                                Margin="8,0,0,0"
                                Appearance="Danger"
                                Command="{Binding DeactivateCommand}"
                                Content="Ngừng lưu hành" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <ui:Button Command="{Binding PreviousPageCommand}" Content="Trước" Style="{StaticResource GhostButtonStyle}" />
                            <TextBlock Margin="12,0" VerticalAlignment="Center" Text="{Binding PageSummary}" />
                            <ui:Button Command="{Binding NextPageCommand}" Content="Sau" Style="{StaticResource GhostButtonStyle}" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="{Binding TotalCount, StringFormat=Tổng: {0}}" />
                            <ComboBox Width="70" ItemsSource="{Binding PageSizes}" SelectedItem="{Binding PageSize}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <TabItem Header="Thêm / cập nhật">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="20" MaxWidth="920">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="Mã sách *" />
                            <ui:TextBox
                                x:Name="BookCodeInput"
                                Margin="0,6,0,0"
                                MaxLength="20"
                                Text="{Binding BookCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=BookCodeInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=BookCodeInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="ISBN" />
                            <ui:TextBox
                                x:Name="IsbnInput"
                                Margin="0,6,0,0"
                                Text="{Binding ISBN, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=IsbnInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=IsbnInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Tên sách *" />
                            <ui:TextBox
                                x:Name="BookTitleInput"
                                Margin="0,6,0,0"
                                MaxLength="300"
                                Text="{Binding Title, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=BookTitleInput}"
                                Visibility="{Binding (Validation.HasError), ElementName=BookTitleInput, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Nhà xuất bản *" />
                            <ComboBox
                                Margin="0,6,0,0"
                                DisplayMemberPath="Name"
                                ItemsSource="{Binding Publishers}"
                                SelectedItem="{Binding SelectedPublisher, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Tác giả *" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Authors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Thể loại *" />
                            <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding BookCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock FontWeight="SemiBold" Text="Năm xuất bản *" />
                            <ui:NumberBox
                                Margin="0,6,0,0"
                                Maximum="{Binding Source={x:Static sys:DateTime.Now}, Path=Year}"
                                Minimum="1000"
                                Value="{Binding PublicationYear}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Ngôn ngữ" />
                            <ui:TextBox Margin="0,6,0,0" MaxLength="50" Text="{Binding Language}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Số trang *" />
                            <ui:NumberBox Margin="0,6,0,0" Minimum="1" Value="{Binding PageCount}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Giá sách" />
                            <ui:NumberBox Margin="0,6,0,0" Minimum="0" Value="{Binding Price}" />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Ảnh bìa" />
                            <Border
                                Width="120"
                                Height="160"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <Image Source="{Binding CoverImagePreviewPath}" Stretch="UniformToFill" />
                            </Border>
                            <ui:Button
                                Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding ChooseCoverCommand}"
                                Content="Chọn ảnh..." />
                            <TextBlock Margin="0,12,0,0" FontWeight="SemiBold" Text="Mô tả" />
                            <ui:TextBox
                                MinHeight="90"
                                Margin="0,6,0,0"
                                AcceptsReturn="True"
                                MaxLength="4000"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,10,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                            <ui:Button
                                MinHeight="{StaticResource ButtonHeight}"
                                Margin="0,16,0,0"
                                Appearance="Primary"
                                Command="{Binding SaveCommand}"
                                Content="Lưu sách" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border
            Grid.RowSpan="3"
            Panel.ZIndex="50"
            Background="#66000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock Margin="0,10,0,0" Foreground="White" Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
