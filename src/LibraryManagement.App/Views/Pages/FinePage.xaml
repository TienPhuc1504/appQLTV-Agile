<Page
    x:Class="LibraryManagement.App.Views.Pages.FinePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Tiền phạt"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <TextBlock
                FontSize="28"
                FontWeight="SemiBold"
                Text="Quản lý tiền phạt" />
            <TextBlock
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                Text="{Binding TotalCount, StringFormat=Tổng số: {0} khoản phạt}" />
        </Grid>

        <Border
            Grid.Row="1"
            Margin="0,18,0,16"
            Padding="16"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    Margin="0,0,8,0"
                    AutomationProperties.Name="Từ khóa tiền phạt"
                    MaxLength="150"
                    PlaceholderText="Mã phạt, mã hoặc tên độc giả..."
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    ItemsSource="{Binding FineTypeOptions}"
                    SelectedItem="{Binding SelectedFineType}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FineTypeConverter}, TargetNullValue=Tất cả loại}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ComboBox
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    ItemsSource="{Binding StatusOptions}"
                    SelectedItem="{Binding SelectedStatus}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource FineStatusConverter}, TargetNullValue=Tất cả trạng thái}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <ui:Button
                    Grid.Column="3"
                    AutomationProperties.Name="Tìm kiếm tiền phạt"
                    Command="{Binding SearchCommand}"
                    Content="Tìm kiếm"
                    Icon="{ui:SymbolIcon Search24}"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
                <DataGrid
                    AutomationProperties.Name="Danh sách tiền phạt"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    ItemsSource="{Binding Fines}"
                    SelectedItem="{Binding SelectedFine}"
                    SelectionChanged="OnFineSelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="115"
                            Binding="{Binding FineCode}"
                            Header="Mã phạt" />
                        <DataGridTextColumn
                            Width="120"
                            Binding="{Binding ReaderCode}"
                            Header="Mã độc giả" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding ReaderName}"
                            Header="Độc giả" />
                        <DataGridTextColumn
                            Width="105"
                            Binding="{Binding FineType, Converter={StaticResource FineTypeConverter}}"
                            Header="Loại" />
                        <DataGridTextColumn
                            Width="105"
                            Binding="{Binding OutstandingAmount, StringFormat={}{0:N0} đ}"
                            Header="Còn lại" />
                        <DataGridTextColumn
                            Width="125"
                            Binding="{Binding Status, Converter={StaticResource FineStatusConverter}}"
                            Header="Trạng thái" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="16"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Chi tiết khoản phạt" />
                        <TextBlock
                            Margin="0,12,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding FineDetail.FineCode, TargetNullValue=Chưa chọn khoản phạt}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Text="{Binding FineDetail.ReaderName}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding FineDetail.BookTitle}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Text="{Binding FineDetail.Amount, StringFormat=Tổng tiền phạt: {0:N0} đ}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Text="{Binding FineDetail.PaidAmount, StringFormat=Đã thanh toán: {0:N0} đ}" />
                        <TextBlock
                            Margin="0,3,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding FineDetail.OutstandingAmount, StringFormat=Còn lại: {0:N0} đ}" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Text="{Binding FineDetail.Reason}"
                            TextWrapping="Wrap" />

                        <Separator Margin="0,16" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Thanh toán" />
                        <ui:NumberBox
                            Margin="0,10,0,0"
                            AutomationProperties.Name="Số tiền thanh toán"
                            Minimum="0"
                            Value="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged}" />
                        <ComboBox
                            Margin="0,8,0,0"
                            ItemsSource="{Binding PaymentMethods}"
                            SelectedItem="{Binding SelectedPaymentMethod}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource PaymentMethodConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ui:TextBox
                            Margin="0,8,0,0"
                            MaxLength="1000"
                            PlaceholderText="Ghi chú thanh toán..."
                            Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            Appearance="Primary"
                            AutomationProperties.Name="Thanh toán tiền phạt"
                            Command="{Binding PayCommand}"
                            Content="Thanh toán"
                            IsEnabled="{Binding CanPaySelectedFine}" />

                        <Separator Margin="0,16" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Miễn phạt" />
                        <ui:TextBox
                            Margin="0,10,0,0"
                            MaxLength="500"
                            PlaceholderText="Lý do miễn phạt..."
                            Text="{Binding WaiverReason, UpdateSourceTrigger=PropertyChanged}" />
                        <ui:Button
                            Margin="0,8,0,0"
                            Appearance="Caution"
                            AutomationProperties.Name="Miễn tiền phạt"
                            Command="{Binding WaiveCommand}"
                            Content="Miễn phạt"
                            IsEnabled="{Binding CanWaiveSelectedFine}" />

                        <Separator Margin="0,16" />
                        <TextBlock
                            FontSize="16"
                            FontWeight="SemiBold"
                            Text="Lịch sử thanh toán" />
                        <DataGrid
                            Height="180"
                            Margin="0,10,0,0"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Payments}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="95"
                                    Binding="{Binding Amount, StringFormat={}{0:N0} đ}"
                                    Header="Số tiền" />
                                <DataGridTextColumn
                                    Width="*"
                                    Binding="{Binding PaymentDate, StringFormat={}{0:dd/MM/yyyy HH:mm}}"
                                    Header="Thời gian" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                Text="{Binding ErrorMessage}"
                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button
                    Command="{Binding PreviousPageCommand}"
                    Content="Trang trước"
                    Style="{StaticResource GhostButtonStyle}" />
                <TextBlock
                    Margin="12,0"
                    VerticalAlignment="Center"
                    Text="{Binding PageNumber, StringFormat=Trang {0}}" />
                <TextBlock
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Text="{Binding TotalPages, StringFormat=/ {0}}" />
                <ui:Button
                    Command="{Binding NextPageCommand}"
                    Content="Trang sau"
                    Style="{StaticResource GhostButtonStyle}" />
            </StackPanel>
        </Grid>

        <Border
            Grid.RowSpan="4"
            Panel.ZIndex="20"
            Background="#66000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="White"
                    Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
