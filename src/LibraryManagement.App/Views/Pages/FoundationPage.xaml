<Page
    x:Class="LibraryManagement.App.Views.Pages.FoundationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Nền tảng ứng dụng"
    d:DesignHeight="600"
    d:DesignWidth="900"
    mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock
                    FontSize="28"
                    FontWeight="SemiBold"
                    Text="Nền tảng ứng dụng" />
                <TextBlock
                    Margin="0,8,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Giai đoạn 3: MVVM, điều hướng, validation, loading, dialog, snackbar và theme." />
            </StackPanel>

            <Border
                Grid.Row="1"
                MaxWidth="720"
                Margin="0,28,0,0"
                Padding="24"
                HorizontalAlignment="Left"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="8">
                <StackPanel>
                    <TextBlock
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Kiểm tra nền tảng" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Text="Nhập tối thiểu 3 ký tự rồi chạy kiểm tra:" />
                    <ui:TextBox
                        Margin="0,12,0,0"
                        Text="{Binding VerificationText, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                    <TextBlock
                        Margin="0,8,0,0"
                        Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                        Text="{Binding ErrorMessage}"
                        Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                        <ui:Button
                            Appearance="Primary"
                            Command="{Binding VerifyCommand}"
                            Content="Chạy kiểm tra"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                        <ui:Button
                            Margin="12,0,0,0"
                            Command="{Binding ShowDialogCommand}"
                            Content="Mở hộp thoại"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border
                Grid.RowSpan="2"
                Panel.ZIndex="10"
                Background="#66000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,12,0,0"
                        Foreground="White"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
