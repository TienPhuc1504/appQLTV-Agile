<Page
    x:Class="LibraryManagement.App.Views.Pages.EmployeePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Nhân viên"
    Loaded="OnLoaded"
    Unloaded="OnUnloaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            FontSize="28"
            FontWeight="SemiBold"
            Text="Quản lý nhân viên" />
        <Grid Grid.Row="1" Margin="0,18,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox
                Margin="0,0,10,0"
                AutomationProperties.Name="Tìm nhân viên"
                PlaceholderText="Mã, tên hoặc tên đăng nhập..."
                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
            <ui:Button
                Grid.Column="1"
                Command="{Binding SearchCommand}"
                Content="Tìm kiếm" />
            <ui:Button
                Grid.Column="2"
                Margin="10,0,0,0"
                Appearance="Primary"
                Command="{Binding NewCommand}"
                Content="Thêm nhân viên" />
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="2*" />
            </Grid.ColumnDefinitions>
            <DataGrid
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                IsReadOnly="True"
                ItemsSource="{Binding Employees}"
                SelectedItem="{Binding SelectedEmployee}"
                SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="90" Binding="{Binding EmployeeCode}" Header="Mã NV" />
                    <DataGridTextColumn Width="*" Binding="{Binding FullName}" Header="Họ tên" />
                    <DataGridTextColumn Width="120" Binding="{Binding Username}" Header="Tài khoản" />
                    <DataGridTextColumn Width="120" Binding="{Binding RoleName}" Header="Vai trò" />
                    <DataGridCheckBoxColumn Width="80" Binding="{Binding IsActive}" Header="Hoạt động" />
                </DataGrid.Columns>
            </DataGrid>
            <Border
                Grid.Column="2"
                Padding="18"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Thông tin nhân viên" />
                        <TextBlock Margin="0,12,0,4" Text="Mã nhân viên *" />
                        <ui:TextBox
                            IsReadOnly="{Binding IsEditing}"
                            MaxLength="20"
                            Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Margin="0,10,0,4" Text="Họ tên *" />
                        <ui:TextBox
                            MaxLength="150"
                            Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Margin="0,10,0,4" Text="Ngày sinh" />
                        <DatePicker SelectedDate="{Binding DateOfBirth}" />
                        <TextBlock Margin="0,10,0,4" Text="Giới tính" />
                        <ComboBox ItemsSource="{Binding Genders}" SelectedItem="{Binding Gender}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource GenderConverter}}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock Margin="0,10,0,4" Text="Số điện thoại" />
                        <ui:TextBox MaxLength="20" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Text="Email" />
                        <ui:TextBox
                            MaxLength="254"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Margin="0,10,0,4" Text="Địa chỉ" />
                        <ui:TextBox MaxLength="500" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Margin="0,10,0,4" Text="Tên đăng nhập *" />
                        <ui:TextBox
                            MaxLength="50"
                            Text="{Binding Username, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                        <TextBlock Margin="0,10,0,4" Text="Vai trò" />
                        <ComboBox
                            DisplayMemberPath="Description"
                            ItemsSource="{Binding Roles}"
                            SelectedValue="{Binding SelectedRoleId}"
                            SelectedValuePath="Id" />
                        <TextBlock Margin="0,10,0,4" Text="Mật khẩu ban đầu / mật khẩu mới" />
                        <PasswordBox
                            x:Name="PasswordInput"
                            AutomationProperties.Name="Mật khẩu nhân viên"
                            PasswordChanged="OnPasswordChanged" />
                        <TextBlock
                            Margin="0,10,0,0"
                            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                            Text="{Binding ErrorMessage}"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <WrapPanel Margin="0,16,0,0">
                            <ui:Button Appearance="Primary" Command="{Binding SaveCommand}" Content="Lưu" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding ChangeRoleCommand}" Content="Đổi vai trò" />
                            <ui:Button Margin="8,0,0,0" Command="{Binding ResetPasswordCommand}" Content="Reset mật khẩu" />
                            <ui:Button Margin="0,8,0,0" Command="{Binding LockCommand}" Content="Khóa" />
                            <ui:Button Margin="8,8,0,0" Command="{Binding UnlockCommand}" Content="Mở khóa" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <StackPanel Grid.Row="3" Margin="0,14,0,0" HorizontalAlignment="Center" Orientation="Horizontal">
            <ui:Button Command="{Binding PreviousPageCommand}" Content="Trước" />
            <TextBlock Margin="14,0" VerticalAlignment="Center" Text="{Binding PageNumber, StringFormat=Trang {0}}" />
            <TextBlock VerticalAlignment="Center" Text="{Binding TotalPages, StringFormat=/ {0}}" />
            <ui:Button Margin="14,0,0,0" Command="{Binding NextPageCommand}" Content="Sau" />
            <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Text="{Binding TotalCount, StringFormat=Tổng: {0}}" />
        </StackPanel>
        <Border
            Grid.RowSpan="4"
            Panel.ZIndex="10"
            Background="#66000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock Margin="0,10,0,0" Foreground="White" Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
