<Page
    x:Class="LibraryManagement.App.Views.Pages.CategoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="clr-namespace:LibraryManagement.App.Controls"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Thể loại"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    Loaded="OnLoaded"
    mc:Ignorable="d">
    <Grid Margin="{StaticResource PagePadding}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{StaticResource SectionSpacing}" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <controls:PageHeader
            Description="Quản lý các thể loại dùng để phân loại sách trong thư viện."
            Title="Quản lý thể loại">
            <controls:PageHeader.TrailingContent>
                <ui:Button
                    MinWidth="110"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Appearance="Primary"
                    Command="{Binding NewCommand}"
                    Content="Thêm mới" />
            </controls:PageHeader.TrailingContent>
        </controls:PageHeader>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="420" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" MinWidth="290" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        MinHeight="38"
                        PlaceholderText="Tìm theo tên hoặc mô tả..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <CheckBox
                        Grid.Column="1"
                        Margin="16,0,0,0"
                        VerticalAlignment="Center"
                        Content="Hiện ngừng sử dụng"
                        IsChecked="{Binding IncludeInactive}" />
                    <ui:Button
                        Grid.Column="2"
                        Margin="12,0,0,0"
                        Command="{Binding SearchCommand}"
                        Content="Tìm kiếm"
                        Icon="{ui:SymbolIcon Search24}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <DataGrid
                        x:Name="CategoryGrid"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding Items}"
                        SelectedItem="{Binding SelectedItem}"
                        SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="2*"
                                Binding="{Binding Name}"
                                Header="Tên thể loại" />
                            <DataGridTextColumn
                                Width="3*"
                                Binding="{Binding Description}"
                                Header="Mô tả" />
                            <DataGridCheckBoxColumn
                                Width="90"
                                Binding="{Binding IsActive}"
                                Header="Hoạt động" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Không có thể loại phù hợp.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger
                                        Binding="{Binding HasItems, ElementName=CategoryGrid}"
                                        Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>

                <TextBlock
                    Grid.Row="2"
                    Margin="0,10,0,0"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="{Binding Items.Count, StringFormat=Tổng số: {0} thể loại}" />
            </Grid>

            <Border
                Grid.Column="2"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24">
                <Grid>
                    <StackPanel
                        MaxWidth="320"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding IsEmptyMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            FontSize="36"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Symbol="Tag24" />
                        <TextBlock
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Style="{StaticResource SectionTitleTextStyle}"
                            Text="Chưa chọn thể loại"
                            TextAlignment="Center" />
                        <TextBlock
                            Margin="0,8,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="Chọn một thể loại trong danh sách để chỉnh sửa hoặc nhấn “Thêm mới” để tạo thể loại."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <ui:Button
                            MinHeight="36"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            Appearance="Primary"
                            Command="{Binding NewCommand}"
                            Content="Thêm thể loại" />
                    </StackPanel>

                    <ScrollViewer
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto"
                        Visibility="{Binding IsFormMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <TextBlock
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold"
                                Text="{Binding EditorEyebrow}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Style="{StaticResource SectionTitleTextStyle}"
                                Text="{Binding EditorTitle}" />
                            <TextBlock
                                Margin="0,8,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding EditorDescription}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                Margin="0,24,0,8"
                                FontWeight="SemiBold"
                                Text="Tên thể loại *" />
                            <ui:TextBox
                                x:Name="CategoryNameInput"
                                MinHeight="40"
                                MaxLength="100"
                                Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CategoryNameInput}"
                                TextWrapping="Wrap"
                                Visibility="{Binding (Validation.HasError), ElementName=CategoryNameInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,16,0,8"
                                FontWeight="SemiBold"
                                Text="Mô tả" />
                            <ui:TextBox
                                x:Name="CategoryDescriptionInput"
                                MinHeight="110"
                                MaxLength="500"
                                AcceptsReturn="True"
                                Text="{Binding Description, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,4,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding (Validation.Errors)[0].ErrorContent, ElementName=CategoryDescriptionInput}"
                                TextWrapping="Wrap"
                                Visibility="{Binding (Validation.HasError), ElementName=CategoryDescriptionInput, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock
                                Margin="0,16,0,0"
                                Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                Text="{Binding ErrorMessage}"
                                TextWrapping="Wrap"
                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <StackPanel
                                Margin="0,24,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                                <ui:Button
                                    MinHeight="36"
                                    Command="{Binding CancelCommand}"
                                    Content="{Binding CancelActionText}" />
                                <ui:Button
                                    MinHeight="36"
                                    Margin="8,0,0,0"
                                    Appearance="Primary"
                                    Command="{Binding SaveCommand}"
                                    Content="{Binding SaveActionText}" />
                            </StackPanel>

                            <StackPanel
                                Visibility="{Binding IsEditMode, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Separator Margin="0,24,0,24" />
                                <TextBlock
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    Text="Trạng thái" />
                                <TextBlock
                                    Margin="0,8,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{Binding StatusText}" />
                                <ui:Button
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Left"
                                    Command="{Binding ToggleStatusCommand}"
                                    Content="{Binding StatusActionText}">
                                    <ui:Button.Style>
                                        <Style
                                            BasedOn="{StaticResource SecondaryButtonStyle}"
                                            TargetType="{x:Type ui:Button}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.IsActive}" Value="True">
                                                    <Setter Property="Appearance" Value="Danger" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ui:Button.Style>
                                </ui:Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border
                Grid.ColumnSpan="3"
                Panel.ZIndex="20"
                Background="#66000000"
                Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ui:ProgressRing IsIndeterminate="True" />
                    <TextBlock
                        Margin="0,10,0,0"
                        Foreground="White"
                        Text="{Binding BusyMessage}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
