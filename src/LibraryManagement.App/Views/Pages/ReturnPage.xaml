<Page
    x:Class="LibraryManagement.App.Views.Pages.ReturnPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Trả sách"
    mc:Ignorable="d">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="28"
            FontWeight="SemiBold"
            Text="Xử lý trả sách" />

        <Border
            Grid.Row="1"
            Margin="0,18,0,16"
            Padding="18"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox
                    MaxLength="150"
                    AutomationProperties.Name="Mã phiếu mượn hoặc mã bản sách"
                    PlaceholderText="Nhập mã phiếu mượn hoặc mã bản sách..."
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                <ui:Button
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    AutomationProperties.Name="Tìm sách đang mượn"
                    Command="{Binding SearchCommand}"
                    Content="Tìm kiếm"
                    Icon="{ui:SymbolIcon Search24}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Margin="2,0,0,10"
                        FontSize="17"
                        FontWeight="SemiBold"
                        Text="Phiếu mượn phù hợp" />
                    <DataGrid
                        x:Name="ReturnSearchResultGrid"
                        Grid.Row="1"
                        AutomationProperties.Name="Kết quả tìm phiếu trả"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        ItemsSource="{Binding SearchResults}"
                        SelectedItem="{Binding SelectedBorrowSlip}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="115"
                                Binding="{Binding BorrowCode}"
                                Header="Mã phiếu" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ReaderName}"
                                Header="Độc giả" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Border
                Grid.Column="2"
                Padding="14"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                CornerRadius="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="2,0,0,10">
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="{Binding SelectedBorrowSlip.ReaderName, TargetNullValue=Danh sách sách chưa trả}" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="{Binding SelectedBorrowSlip.BorrowCode}" />
                    </Grid>

                    <DataGrid
                        x:Name="ReturnItemGrid"
                        Grid.Row="1"
                        AutomationProperties.Name="Danh sách sách cần trả"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HeadersVisibility="Column"
                        ItemsSource="{Binding ReturnItems}">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn
                                Width="48"
                                Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                Header="Chọn" />
                            <DataGridTextColumn
                                Width="100"
                                Binding="{Binding Book.CopyCode}"
                                Header="Mã bản" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Book.BookTitle}"
                                Header="Tên sách" />
                            <DataGridTextColumn
                                Width="92"
                                Binding="{Binding Book.ExpectedReturnDate, StringFormat={}{0:dd/MM/yyyy}}"
                                Header="Hẹn trả" />
                            <DataGridTextColumn
                                Width="65"
                                Binding="{Binding OverdueDays}"
                                Header="Quá hạn" />
                            <DataGridTemplateColumn Width="125" Header="Tình trạng">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox
                                            ItemsSource="{Binding AvailableConditions}"
                                            SelectedItem="{Binding ReturnedCondition, UpdateSourceTrigger=PropertyChanged}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource PhysicalConditionConverter}}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="150" Header="Ghi chú">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox
                                            MaxLength="1000"
                                            Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn
                                Width="105"
                                Binding="{Binding EstimatedFineAmount, StringFormat={}{0:N0} đ}"
                                Header="Phạt dự kiến"
                                IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Text="{Binding TotalEstimatedFine, StringFormat=Tổng tiền phạt dự kiến: {0:N0} đ}" />
                            <TextBlock
                                Margin="0,3,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                Text="{Binding SelectedBookCount, StringFormat=Đã chọn: {0} bản sách}" />
                        </StackPanel>
                        <StackPanel
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                Command="{Binding PreviewFinesCommand}"
                                Content="Tính tiền phạt"
                                Icon="{ui:SymbolIcon Calculator24}" />
                            <ui:Button
                                Margin="10,0,0,0"
                                AutomationProperties.Name="Gia hạn sách đã chọn"
                                Command="{Binding RenewSelectedCommand}"
                                Content="Gia hạn" />
                            <ui:Button
                                Margin="10,0,0,0"
                                Appearance="Primary"
                                AutomationProperties.Name="Xác nhận trả sách"
                                Command="{Binding ConfirmReturnCommand}"
                                Content="Xác nhận trả"
                                Icon="{ui:SymbolIcon CheckmarkCircle24}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            Grid.Row="3"
            Margin="0,12,0,0"
            Foreground="{DynamicResource SystemFillColorCriticalBrush}"
            Text="{Binding ErrorMessage}"
            TextWrapping="Wrap"
            Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border
            Grid.RowSpan="4"
            Panel.ZIndex="20"
            Background="#66000000"
            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" />
                <TextBlock
                    Margin="0,12,0,0"
                    Foreground="White"
                    Text="{Binding BusyMessage}" />
            </StackPanel>
        </Border>
    </Grid>
</Page>
