<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LibraryManagement.App.Controls">
    <Thickness x:Key="PagePadding">24</Thickness>
    <GridLength x:Key="SectionSpacing">24</GridLength>

    <Style x:Key="PageTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="SectionTitleTextStyle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter
            Property="Foreground"
            Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style TargetType="{x:Type controls:PageHeader}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:PageHeader}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                x:Name="IconPresenter"
                                Margin="0,0,12,0"
                                VerticalAlignment="Top"
                                Content="{TemplateBinding Icon}" />

                            <StackPanel
                                x:Name="TextArea"
                                Grid.Column="1">
                                <TextBlock
                                    Style="{StaticResource PageTitleTextStyle}"
                                    Text="{TemplateBinding Title}" />
                                <TextBlock
                                    x:Name="DescriptionText"
                                    Margin="0,4,0,0"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    Text="{TemplateBinding Description}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ContentPresenter
                            x:Name="TrailingContentPresenter"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding TrailingContent}" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter
                                TargetName="IconPresenter"
                                Property="Visibility"
                                Value="Collapsed" />
                            <Setter
                                TargetName="TextArea"
                                Property="Grid.Column"
                                Value="0" />
                            <Setter
                                TargetName="TextArea"
                                Property="Grid.ColumnSpan"
                                Value="2" />
                        </Trigger>
                        <Trigger Property="Description" Value="">
                            <Setter
                                TargetName="DescriptionText"
                                Property="Visibility"
                                Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter
                                TargetName="DescriptionText"
                                Property="Visibility"
                                Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="TrailingContent" Value="{x:Null}">
                            <Setter
                                TargetName="TrailingContentPresenter"
                                Property="Visibility"
                                Value="Collapsed" />
                            <Setter
                                TargetName="TrailingContentPresenter"
                                Property="Margin"
                                Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
